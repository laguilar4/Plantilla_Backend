# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=*

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=api_base
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Security
API_KEY=change-me-super-secret-key
